      {player}. \u0417\u0435\u043C\u043B\u0438 \u0443 \u043C\u0435\u043D\u044F \u043D\u0435\u0442,
      \u0435\u0441\u0442\u044C \u043C\u0435\u0447 \u0438 \u043A\u043E\u043D\u044C.
