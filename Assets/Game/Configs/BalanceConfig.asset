  PhaseButtons:
  - "\u0420\u0430\u0441\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u0434\u0432\u043E\u0440"
  - "\u0412\u0435\u0447\u0435\u0440\u0435\u0435\u0442"
  - "\u041D\u043E\u0447\u044C"
  - "\u0421\u043F\u0430\u0442\u044C"
  EveningQuietText: "\u0421\u0432\u0435\u0447\u0438 \u0434\u043E\u0433\u043E\u0440\u0435\u043B\u0438,
    \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u043F\u0440\u0438\u0448\u0451\u043B.
    \u041B\u0435\u0442\u043E\u043F\u0438\u0441\u0435\u0446 \u0437\u0430\u043F\u0438\u0441\u0430\u043B:
    \xAB\u0434\u0435\u043D\u044C \u0431\u0435\u0437 \u043F\u0440\u043E\u0438\u0441\u0448\u0435\u0441\u0442\u0432\u0438\u0439\xBB
    \u2014 \u0438, \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0431\u044B\u043B
    \u0440\u0430\u0437\u043E\u0447\u0430\u0440\u043E\u0432\u0430\u043D."
  DuelChallengeText: "{lord} \u0436\u0434\u0451\u0442 \u0432\u043E \u0434\u0432\u043E\u0440\u0435
    \u0441 \u043E\u0431\u043D\u0430\u0436\u0451\u043D\u043D\u044B\u043C \u043A\u043B\u0438\u043D\u043A\u043E\u043C.
    \u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F \u043D\u0435\u043B\u044C\u0437\u044F
    \u2014 \u0434\u0432\u043E\u0440 \u0441\u043C\u043E\u0442\u0440\u0438\u0442.\n\n\u0422\u0432\u043E\u0438
    \u0448\u0430\u043D\u0441\u044B: {chance}%."
  DuelWinText: "{lord} \u0443\u043F\u0430\u043B \u043D\u0430 \u0442\u0440\u0435\u0442\u044C\u0435\u043C
    \u0432\u044B\u043F\u0430\u0434\u0435. \u041B\u0435\u0442\u043E\u043F\u0438\u0441\u044C
    \u043E\u0442\u043C\u0435\u0442\u0438\u0442, \u0447\u0442\u043E \u0442\u044B \u0431\u044B\u043B
    \u043C\u0438\u043B\u043E\u0441\u0435\u0440\u0434\u0435\u043D. \u041B\u0435\u0442\u043E\u043F\u0438\u0441\u044C
    \u0441\u043E\u043B\u0436\u0451\u0442."
  FixedSeed: 0
