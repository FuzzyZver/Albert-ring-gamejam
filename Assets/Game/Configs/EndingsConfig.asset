  - Id: 8
    Title: "\u041F\u043E\u0431\u0435\u0434\u0430 \u043D\u0435\u043A\u043E\u043C\u0443
      \u043F\u0440\u0430\u0437\u0434\u043D\u043E\u0432\u0430\u0442\u044C"
    ChronicleLine: "\u041E\u0441\u0430\u0434\u0430 \u0441\u043D\u044F\u0442\u0430.
      \u041D\u0430 \u0441\u0442\u0435\u043D\u0430\u0445 \u0441\u0442\u043E\u044F\u0442
      \u0447\u0435\u0442\u044B\u0440\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u0438 \u0442\u044B. \u041B\u0435\u0442\u043E\u043F\u0438\u0441\u0435\u0446
      \u0437\u0430\u043F\u0438\u0441\u0430\u043B \u043F\u043E\u0431\u0435\u0434\u0443
      \u0438 \u043D\u0430\u0434\u043E\u043B\u0433\u043E \u0437\u0430\u043C\u043E\u043B\u0447\u0430\u043B."
