    Title: "\u0420\u0430\u0437\u0433\u0440\u043E\u043C"
    ChronicleLine: "\u0412\u043E\u0440\u043E\u0442\u0430 \u0434\u0435\u0440\u0436\u0430\u043B\u0438\u0441\u044C
