  - Id: 1
    Title: "\u0413\u043E\u043B\u043E\u0434"
    ChronicleLine: "\u0410\u043C\u0431\u0430\u0440\u044B \u0441\u0442\u043E\u044F\u043B\u0438
      \u043F\u0443\u0441\u0442\u044B\u043C\u0438 \u043D\u0435 \u043F\u0435\u0440\u0432\u0443\u044E
      \u043D\u043E\u0447\u044C. \u0413\u043E\u043B\u043E\u0434 \u043D\u0435 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442
